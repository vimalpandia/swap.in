PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000

MONGODB_URI=mongodb+srv://swap_user:swap_password@cluster0.mongodb.net/swap_db?retryWrites=true&w=majority

# Optional: leave empty to use in-memory cache
REDIS_URL=

JWT_ACCESS_SECRET=swap_access_secret_super_secure_key_at_least_32_chars!
JWT_REFRESH_SECRET=swap_refresh_secret_super_secure_key_at_least_32_chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

LLM_API_KEY=mock-llm-key
