{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run build:shared && npm run build:api && npm run build:web",
  "outputDirectory": "apps/web/.next",
  "functions": {
    "api/index.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "/api?__path=/api/v1/:path*"
    },
    {
      "source": "/health",
      "destination": "/api?__path=/health"
    }
  ]
}
